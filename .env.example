# ---------------------------------------------------------
# Multi-Agent Orchestrator — Environment Variables
# ---------------------------------------------------------
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ---------------------------------------------------------

# PostgreSQL connection string (must match docker-compose.yml credentials)
DATABASE_URL=postgresql://orchestrator:orchestrator@localhost:5433/orchestrator

# Fernet encryption key for api_credentials.api_key column.
# Generate one with:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Shared secret for authenticating MCP clients.
# Any strong random string, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# ---------------------------------------------------------
# Test database (used by pytest — same Postgres instance,
# separate database created by docker/init-test-db.sql)
# ---------------------------------------------------------
TEST_DATABASE_URL=postgresql://orchestrator:orchestrator@localhost:5433/orchestrator_test

# ---------------------------------------------------------
# Read-only Web Dashboard Authentication (HTTP Basic Auth)
# ---------------------------------------------------------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=orchestrator_secret

